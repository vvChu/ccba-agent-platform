# Processing Workspace (.md/)
# Temp files during processing are ignored, but structure is tracked
.md/**/*.pdf
.md/**/*.docx
.md/**/*.xlsx
.md/**/*.pptx
.md/**/*.txt
# Except keep markdown and raw transcripts in general folders
!.md/**/raw_transcript.txt
.md/extracted_docs/*
!.md/extracted_docs/.gitkeep
# Ignore images of youtube-learn
.md/**/images/*.webp
.md/**/images/*.jpg
.md/**/images/*.png

# Ignore all specific project outputs (OneDrive/SharePoint synced)
.md/projects/*
!.md/projects/.gitkeep

# Build artifacts
dist/
*.whl
*.tar.gz

# Logs
*.log
.md/logs/
.md/**/nightly_tuner_report_*.md

# Temp/debug files in root
*.docx

# Gemini Agent
.gemini/

# Ruff cache
.ruff_cache/

# Temporary study files
claudekit-engineer/
# Ignore toàn bộ nội dung trong .agents mặc định để loại bỏ rác chạy subagents
.agents/*

# Nhưng cho phép theo dõi các tri thức và hiến pháp chính quy
!.agents/workflows/
!.agents/skills/
!.agents/proposals/
!.agents/rules/
!.agents/resources/
!.agents/templates/
!.agents/AGENTS.md

# Loại trừ các dữ liệu động, log, credentials bên trong các thư mục chính quy này
.agents/**/*.log
.agents/**/*.json
!.agents/skills/eval-gate/test_cases/*.json
!.agents/skills/ccba-eval-gate/test_cases/*.json
.agents/**/*.env
.agents/**/__pycache__/
.agents/**/*.pyc
scripts/verify_report.py
.md/claudekit_last_sha.txt

# Spoke Registry Decrypted (Local-Only)
.md/data/spoke_registry_decrypted.yaml

# Temp logs and scratch
.md/scratch/

# Node dependencies
node_modules/

# Security and Credentials
secret_credential.*
*.db
!Thumbs.db

# Spoke-Exclusive Domains (Protected by Zero-Duplication SSOT)
.md/legal_docs/
.md/governance_constitution/
.md/system_blueprint/
specs/modules/
.md/telemetry/

