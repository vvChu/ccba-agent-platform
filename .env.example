# CCBA Agent Platform — Environment Variables
# Copy this file to .env and fill in your values

# === AI Gateway (Server Spark) ===
# Dùng cho ccba-ai package và mdconverter service
AI_GATEWAY_URL=http://100.83.192.30:8090/v1
AI_GATEWAY_KEY=
AI_MODEL=qwen3.5-35b

# === mdconverter Service ===
# Conversion settings
MDCONVERT_MAX_OUTPUT_TOKENS=65536
MDCONVERT_TIMEOUT_SECONDS=600
MDCONVERT_TEMPERATURE=0.1

# Quality settings
MDCONVERT_MIN_CONTENT_LENGTH=100
MDCONVERT_HIGH_QUALITY_THRESHOLD=95

# LlamaCloud API Key (optional — for LlamaParse)
MDCONVERT_LLAMA_CLOUD_API_KEY=

# === CCBA Platform Settings ===
# Path to the CCBA Hub workspace (D:\GitHubProjects\ccba-agent-platform)
CCBA_HUB_PATH=

# Path to the BIGBIM Method knowledge base workspace (D:\GitHubProjects\BIGBIM_Method)
BIGBIM_METHOD_PATH=

# === NotebookLM API / Session Settings ===
NOTEBOOKLM_SESSION_COOKIE=
NOTEBOOKLM_COOKIES_JSON=

# === Thư viện Pháp luật Credentials ===
# Credentials for thuvienphapluat.vn auto-login
TVPL_USERNAME=
TVPL_PASSWORD=

# === NotebookLM Dynamic IDs Override ===
# Optional override for default Google Notebook IDs in catalog.yaml
# NOTEBOOKLM_<BUNDLE_NAME_UPPER>_ID=your-notebook-id
NOTEBOOKLM_CORE_ID=
NOTEBOOKLM_QC_ID=

