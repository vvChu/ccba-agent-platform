# CCBA Agent Platform — Environment Variables
# Copy this file to .env and fill in your values

# === AI Gateway (Server Spark) ===
# Dùng cho ccba-ai package và mdconverter service
AI_GATEWAY_URL=http://100.83.192.30:8090/v1
AI_GATEWAY_KEY=sk-spark-secure-key-2026
AI_GATEWAY_TIMEOUT=90.0
AI_MODEL=gemini-3.7-flash
LITELLM_MASTER_KEY=sk-spark-secure-key-2026

# === Local GPU Model Settings ===
LOCAL_PRIMARY_LLM_DIR=D:\LLM_Models\Qwen2.5-32B-Instruct
LOCAL_PRIMARY_SERVED_NAME=qwen-local-primary

# === RAG & Vision Optimization (Free Tier Farm Routing) ===
MAX_OCR_CONCURRENCY=4
PRIMARY_VISION_MODEL=ocr-primary               # Cloud Vision (Gemini 3.1 Flash Lite)
FALLBACK_VISION_MODEL=ocr-fallback             # Cloud Backup (Gemini 3.5 Flash Lite)
TABLE_VISION_MODEL=rag-core                    # Offload to Local Qwen 35B
FIGURE_DESC_MODEL=rag-core                     # Offload to Local Qwen 35B
METADATA_FALLBACK=rag-core                     # Text Fallback

# === mdconverter Service ===
# Conversion settings
MDCONVERT_MAX_OUTPUT_TOKENS=65536
MDCONVERT_TIMEOUT_SECONDS=600
MDCONVERT_TEMPERATURE=0.1

# Quality settings
MDCONVERT_MIN_CONTENT_LENGTH=100
MDCONVERT_HIGH_QUALITY_THRESHOLD=95

# LlamaCloud API Key (optional — for LlamaParse)
MDCONVERT_LLAMA_CLOUD_API_KEY=

# Validation settings
EXCLUSION_HEADERS=

# === CCBA Platform Settings ===
# Path to the CCBA Hub workspace (D:\GitHubProjects\ccba-agent-platform)
CCBA_HUB_PATH=

# Path to the BIGBIM Method knowledge base workspace (D:\GitHubProjects\BIGBIM_Method)
BIGBIM_METHOD_PATH=

# === NotebookLM API / Session Settings ===
NOTEBOOKLM_SESSION_COOKIE=
NOTEBOOKLM_COOKIES_JSON=

# === Thư viện Pháp luật Credentials ===
# Credentials for thuvienphapluat.vn auto-login
TVPL_USERNAME=
TVPL_PASSWORD=

# === NotebookLM Dynamic IDs Override ===
# Optional override for default Google Notebook IDs in catalog.yaml
# NOTEBOOKLM_<BUNDLE_NAME_UPPER>_ID=your-notebook-id
NOTEBOOKLM_CORE_ID=
NOTEBOOKLM_QC_ID=

# === IDOP & Microsoft 365 Enterprise Governance (ADR 0042 / ADR 0043) ===
IDOP_ENV=DEV                                       # DEV (Mock Sandbox) or PROD (Live SharePoint)
IDOP_CERT_PATH=                                    # Path to idop_deploy.pfx
IDOP_CERT_PASSWORD=                                # Password for idop_deploy.pfx
IDOP_TENANT_URL=https://ccba.sharepoint.com/sites/idop

# === Telegram Bot Notifications (Nightly Auto-Tuner) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Optional Direct Cloud Fallback Keys (Tier 2 Fallback) ===
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
