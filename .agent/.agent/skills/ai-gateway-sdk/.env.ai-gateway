# ============================================================
# AI Gateway — Kết nối Server DGX Spark
# ============================================================
# Copy file này vào root project của bạn, đổi tên thành .env
# Đảm bảo .env có trong .gitignore!
# ============================================================

# --- Server Connection ---
# Chọn 1 IP phù hợp:
#   Tailscale (khuyến nghị): 100.83.192.30
#   LAN (cùng mạng):        <LAN_IP — hỏi admin>
#   SSH Tunnel:              localhost
AI_GATEWAY_URL=http://100.83.192.30:8090/v1
AI_GATEWAY_KEY=sk-spark-secure-key-2026

# --- OpenAI SDK Compatible (auto-detected by openai package) ---
OPENAI_API_BASE=http://100.83.192.30:8090/v1
OPENAI_API_KEY=sk-spark-secure-key-2026

# --- Default Model ---
# Local (private, offline):  qwen3.5-35b | rag-core | rag-light
# Cloud (fast):              gemini-3-flash | gemini-3.1-flash-lite
# Cloud (smart):             claude-sonnet-4-6 | gemini-3.1-pro
# Cloud (reasoning):         claude-sonnet-4-6-thinking | claude-opus-4-6-thinking
AI_MODEL=qwen3.5-35b

# --- Direct vLLM Access (optional, chỉ dùng khi cần bypass gateway) ---
# VLLM_35B_URL=http://100.83.192.30:8004/v1
# VLLM_4B_URL=http://100.83.192.30:8003/v1
