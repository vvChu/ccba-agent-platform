# --- AI GATEWAY MASTER CONFIGURATION (TEMPLATE) ---

# 1. REMOTE PROXY / GATEWAY (LiteLLM on Server Spark via Tailscale VPN)
AI_GATEWAY_URL=http://100.83.192.30:8090/v1
AI_GATEWAY_KEY=sk-spark-secure-key-2026
AI_MODEL=qwen-local-primary

# 2. LOCAL GPU ALIASES (Qwen 3.5 35B FP8)
LOCAL_PRIMARY_SERVED_NAME=qwen-local-primary
VLLM_MODEL=rag-core
EVAL_MODEL=rag-core
DEFAULT_RAG_MODEL=rag-core

# 3. CLOUD FALLBACKS (Direct API Access - Replace with your own keys)
GEMINI_API_KEY_2=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# 4. SYSTEM SETTINGS
LITELLM_MASTER_KEY=sk-spark-secure-key-2026
LOG_DIR=logs

# 5. TELEGRAM NOTIFICATIONS
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 6. RAG & VISION OPTIMIZATION (Free Tier Farm Routing)
MAX_OCR_CONCURRENCY=4
MAX_WORKERS=2
MAX_DIGITAL_WORKERS=4
PRIMARY_VISION_MODEL=ocr-primary               # Cloud Vision (Gemini 3.1 Flash Lite)
FALLBACK_VISION_MODEL=ocr-fallback             # Cloud Backup (Gemini 3.5 Flash Lite)
TABLE_VISION_MODEL=rag-core                    # Offload to Local Qwen 35B
FIGURE_DESC_MODEL=rag-core                     # Offload to Local Qwen 35B
METADATA_FALLBACK=rag-core                     # Text Fallback

# 6a. Pipeline Refactor Settings
IMAGE_PREPROCESS=1
OCR_RENDER_DPI=200
CHUNK_MAX_CHARS=14500
CROSS_VALIDATE_OCR=1
REMOVE_WATERMARKS=0

# 7. VOLUME PATHS (Docker Compose mounts)
LEGAL_DOCS_DIR=/home/vvc/Public/VB phap quy
EXPORT_DIR=/home/vvc/Public/exports
