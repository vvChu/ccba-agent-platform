# ============================================================
# AI Gateway — Kết nối Server DGX Spark
# ============================================================
# Copy file này vào root project của bạn, đổi tên thành .env
# Đảm bảo .env có trong .gitignore!
# ============================================================

# --- Server Connection ---
# Thiết lập địa chỉ host qua biến môi trường hoặc VPN Tailscale
AI_GATEWAY_URL=http://${CCBA_AI_GATEWAY_HOST}:8090/v1
AI_GATEWAY_KEY=your_ai_gateway_key_here
AI_GATEWAY_TIMEOUT=90.0

# --- OpenAI SDK Compatible (auto-detected by openai package) ---
OPENAI_API_BASE=http://${CCBA_AI_GATEWAY_HOST}:8090/v1
OPENAI_API_KEY=your_ai_gateway_key_here

# --- Default Model Task Key (Định tuyến chuẩn ADR-0061 qua ccba_ai.routing.choose_model) ---
# Hỗ trợ các khóa tác vụ chuẩn: general, reasoning, coding, ocr, rag, private
AI_MODEL=general
